# Copy to .env for local development. Never commit .env.
# CHIRPS needs no credentials. ERA5-Land credentials live in ~/.cdsapirc, NOT here.

# Allowed: development | test | production
CLIMATEADAPT_ENVIRONMENT=development

# Allowed: DEBUG | INFO | WARNING | ERROR
CLIMATEADAPT_LOG_LEVEL=INFO

# Root for cached data (relative to where you run commands). Already git-ignored.
CLIMATEADAPT_DATA_DIR=data

# Set to false to forbid all network access and use only the local cache.
CLIMATEADAPT_ALLOW_DOWNLOADS=true

# Seconds, applied per network operation.
CLIMATEADAPT_HTTP_TIMEOUT_SECONDS=60

# CHIRPS v3 repository root (the connector appends monthly/global/tifs/<file>).
CLIMATEADAPT_CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS/v3.0

# CHIRPS access mode:
#   remote   - read ONE pixel per month with HTTP range requests (kilobytes, fast; default)
#   download - download whole ~22 MB monthly files (archival provenance with SHA-256)
CLIMATEADAPT_CHIRPS_ACCESS=remote

# Parallel remote reads while warming the cache (1-8). Keep modest to be polite to the server.
CLIMATEADAPT_PREFETCH_WORKERS=4