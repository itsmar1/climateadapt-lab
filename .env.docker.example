# Demo-stack environment template. Copy to .env.docker to customize.
# Public/demo values only here; a real Baseten key belongs in the UNTRACKED
# .env.docker copy (or the shell environment), never in this file or an image.
CLIMATEADAPT_ENVIRONMENT=production
CLIMATEADAPT_LOG_LEVEL=INFO
CLIMATEADAPT_DATA_DIR=/app/data
CLIMATEADAPT_ALLOW_DOWNLOADS=true
CLIMATEADAPT_DEMO_MODE=false
CLIMATEADAPT_API_CORS_ORIGINS=["http://localhost:5173"]
CLIMATEADAPT_BASETEN_API_KEY=
CLIMATEADAPT_BASETEN_BASE_URL=https://inference.baseten.co/v1
CLIMATEADAPT_BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
